APP_NAME="BSP Advancement Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — MySQL / MariaDB, the database that ships with XAMPP.
# The schema is ported 1:1 from the original Drizzle schema, so an existing
# `bsp_lms` database works unchanged.
#
# For a zero-setup local run you can use SQLite instead:
#   DB_CONNECTION=sqlite
#   DB_DATABASE=database/database.sqlite
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bsp_lms
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_general_ci

# The portal keeps its own `sessions` table (token, expires_at) exactly like the
# Next.js app, so we do NOT use Laravel's database session driver.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# SESSION_PATH is intentionally not configurable (hardcoded to "/" in
# config/session.php): Git Bash/MSYS rewrites a value of "/" into
# "C:/Program Files/Git/" and Symfony rejects that as an invalid cookie path.
SESSION_DOMAIN=null

# The portal cookie that carries the session token (matches the Next.js app).
BSP_SESSION_COOKIE=bsp_session
BSP_SESSION_DAYS=14

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Google Drive storage (optional but recommended) — Phase 5.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
DRIVE_TOKEN_SECRET=""
