# Database connection used by the app (src/db/index.ts), drizzle.config.ts,
# and the database created in LOCAL_INSTALL.md step 2.
# Local XAMPP/Laragon default: root with an empty password.
DATABASE_URL=mysql://root@127.0.0.1:3306/demolay_lms

# Optional transactional e-mail. Leave blank/absent for local use; e-mail
# events are just logged on the server instead.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=DeMolay Nexus <no-reply@localhost>
