# Connection string for the MySQL / MariaDB server that ships with XAMPP.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# XAMPP defaults (Windows): user "root", empty password, port 3306.
# If you set a MySQL root password in XAMPP, add it after the colon, e.g.
#   DATABASE_URL="mysql://root:yourpassword@127.0.0.1:3306/bsp_lms"
DATABASE_URL="mysql://root:@127.0.0.1:3306/bsp_lms"

# Port the production server listens on. PM2 (ecosystem.config.cjs) reads this
# value, so changing it here and reloading PM2 moves the app to a new port.
PORT="3000"

# Number of PM2 cluster workers. Leave unset (or 1) on a small VPS.
PM2_INSTANCES="1"

# ---------------------------------------------------------------------------
# Google Drive storage (optional but recommended)
# ---------------------------------------------------------------------------
# Scouts upload their video/photo proof straight into their OWN Google Drive,
# so the council server never stores the file. The bytes travel from the
# browser to Google directly — the server only keeps the file id and link.
#
# Setup (one time):
#   1. https://console.cloud.google.com/  ->  create a project.
#   2. APIs & services -> Library -> enable "Google Drive API".
#   3. OAuth consent screen -> External -> add your Scout Leaders and Council
#      Admins as "Test users" while the app is unpublished.
#   4. Credentials -> Create credentials -> OAuth client ID -> Web application.
#      Authorised redirect URI:  http://localhost:3000/api/google/callback
#   5. Paste the client id and client secret below, then restart the app.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Where Google sends the Scout back after signing in. Leave this empty to use
# APP_URL + /api/google/callback.
GOOGLE_REDIRECT_URI=""
APP_URL="http://localhost:3000"

# Random string used to encrypt the stored Google refresh tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DRIVE_TOKEN_SECRET=""
